{
  "headers": [
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=604800, stale-while-revalidate=86400"}]},
    {"source":"/tug-of-war/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=604800, stale-while-revalidate=86400"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]},
