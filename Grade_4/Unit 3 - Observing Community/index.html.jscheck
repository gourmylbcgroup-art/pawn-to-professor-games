
const __VOICE_SPRITE_B64="";
let __voiceCtx=null,__voiceBuffer=null,__voiceReady=null,__voiceDecodeStarted=performance.now();
(function(){
  try{
    const A=window.AudioContext||window.webkitAudioContext;
    if(!A){__voiceReady=Promise.resolve(null);return;}
    try{__voiceCtx=new A({latencyHint:'interactive'})}catch(e){__voiceCtx=new A()}
    const bin=atob(__VOICE_SPRITE_B64),u8=new Uint8Array(bin.length);
    for(let i=0;i<bin.length;i++)u8[i]=bin.charCodeAt(i);
    __voiceReady=__voiceCtx.decodeAudioData(u8.buffer).then(b=>{__voiceBuffer=b;window.__voiceDecodeMs=performance.now()-__voiceDecodeStarted;console.log('Embedded voice ready',Math.round(window.__voiceDecodeMs)+'ms');return b;}).catch(e=>{console.error('embedded voice decode failed',e);return null;});
  }catch(e){console.error('embedded voice init failed',e);__voiceReady=Promise.resolve(null);}
})();


