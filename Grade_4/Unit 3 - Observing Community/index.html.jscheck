let _voiceSource=null;
function normalizeVoiceText(t){return String(t||'').trim()}
function getVoiceCtx(){return __voiceCtx}
function startEmbeddedClip(clip){
  const ctx=getVoiceCtx();if(!ctx||!__voiceBuffer)return false;
  try{
    if(_voiceSource){try{_voiceSource.stop(0)}catch(e){}}
    const src=ctx.createBufferSource();src.buffer=__voiceBuffer;src.connect(ctx.destination);_voiceSource=src;
    src.start(0,clip.start,clip.duration);
    src.onended=()=>{if(_voiceSource===src)_voiceSource=null};
    return true;
  }catch(e){console.error('voice start failed',e);return false}
}
function fallbackSpeak(text){console.warn('Missing embedded audio:',text);toast(text)}
function playSprite(text){
  const key=normalizeVoiceText(text),clip=VOICE_MAP[key];
  if(!clip){fallbackSpeak(text);return}
  const play=()=>{
    const ctx=getVoiceCtx();
    if(!ctx||!__voiceBuffer){fallbackSpeak(text);return}
    if(ctx.state==='suspended')ctx.resume().then(()=>startEmbeddedClip(clip)).catch(()=>fallbackSpeak(text));
    else startEmbeddedClip(clip);
  };
  if(__voiceBuffer)play();
  else if(__voiceReady)__voiceReady.then(buf=>{if(buf)play();else fallbackSpeak(text)});
  else fallbackSpeak(text);
}
function speak(text){playSprite(text)}
function unlockEmbeddedVoice(){
  const ctx=getVoiceCtx();if(!ctx)return;
  const prime=()=>{try{const b=ctx.createBuffer(1,1,ctx.sampleRate),s=ctx.createBufferSource();s.buffer=b;s.connect(ctx.destination);s.start(0)}catch(e){}};
  if(ctx.state==='suspended')ctx.resume().then(prime).catch(()=>{});else prime();
}
window.addEventListener('pointerdown',unlockEmbeddedVoice,{once:true,capture:true});
window.addEventListener('touchstart',unlockEmbeddedVoice,{once:true,capture:true,passive:true});
function openSection(id){qa('.screen').forEach(x=>x.classList.remove('active'));q('#'+id).classList.add('active')}function goHome(){openSection('home')}function setTab(btn,sel){if(!btn)return;qa(sel).forEach(x=>x.classList.remove('on'));btn.classList.add('on')}
function renderPlaces(){q('#placesGrid').innerHTML=PLACES.map(p=>`<button class="card" onclick="speak('${p.id}')"><img src="${p.img}" alt="${p.label}"><div class="name">${p.label}</div></button>`).join('')}
function renderActions(mode='learn',btn){setTab(btn,'[data-acttab]');const b=q('#actionsBody');if(mode==='learn'){b.innerHTML=`<div class="panel"><div class="prompt">Action Words</div><div class="subprompt">Tap each large flashcard to hear the action word.</div><div class="cardGrid">${ACTIONS.map(a=>`<button class="card" onclick="speak('${a.word}')"><img src="${a.img}"><div class="name">${a.word}</div></button>`).join('')}</div></div>`;return}if(mode==='patterns'){b.innerHTML=`<div class="panel"><div class="prompt">Sentence Patterns</div><div class="subprompt">Tap a pattern to hear the complete model.</div><div class="patternGrid"><button class="patternCard" onclick="speak('What is he doing? He is jumping.')"><div class="pron">HE</div><div class="q">What is he doing?</div><div class="a">He is ________.</div></button><button class="patternCard" onclick="speak('What is she doing? She is singing.')"><div class="pron">SHE</div><div class="q">What is she doing?</div><div class="a">She is ________.</div></button><button class="patternCard" onclick="speak('What are you doing? I am reading.')"><div class="pron">I</div><div class="q">What are you doing?</div><div class="a">I am ________.</div></button></div></div>`;return}if(mode==='heShe'){b.innerHTML=`<div class="panel"><div class="prompt">What is he / she doing?</div><div class="subprompt">Tap a card to hear a complete sentence.</div><div class="cardGrid">${ACTIONS.map(a=>`<button class="card" onclick="speak('${a.pro} is ${a.word}.')"><img src="${a.img}"><div class="name">${a.word}</div><div class="sentence">${a.pro} is ${a.word}.</div></button>`).join('')}</div></div>`;return}if(mode==='iAm'){b.innerHTML=`<div class="panel"><div class="prompt">What are you doing?</div><div class="sentenceFrame" onclick="speak('What are you doing? I am jumping.')"><small>Tap to hear the model</small>What are you doing? → <strong>I am ________.</strong></div><div class="cardGrid">${ACTIONS.map(a=>`<button class="card" onclick="speak('I am ${a.word}.')"><img src="${a.img}"><div class="name">${a.word}</div><div class="sentence">I am ${a.word}.</div></button>`).join('')}</div></div>`;return}if(mode==='mission'){b.innerHTML=`<div class="panel mission"><div class="prompt">Ask • Swap • Move</div><div class="subprompt">Use the lesson-plan speaking mission with three partners.</div><div class="steps"><div class="step"><div class="n">1</div><b>ASK</b><p>What are you doing?</p></div><div class="step"><div class="n">2</div><b>ANSWER</b><p>I am [action].</p></div><div class="step"><div class="n">3</div><b>SWAP + MOVE</b><p>Swap only after both students speak.</p></div></div><div class="sentenceFrame" onclick="speak('What are you doing? I am reading.')">What are you doing? → <strong>I am ________.</strong></div><div class="tracker"><div class="track">Partner 1</div><div class="track">Partner 2</div><div class="track">Partner 3</div></div><button class="bigSpeak" onclick="speak('What are you doing? I am reading.')">🔊 Hear model exchange</button></div>`}}
function newWhere(){currentWhere=rand(PLACES);const ref=PLACES.find(p=>p.id==='park');const choices=shuffle([currentWhere,...shuffle(PLACES.filter(p=>p!==currentWhere)).slice(0,3)]);q('#whereBody').innerHTML=`<div class="prompt">Where are you?</div><div class="whereRef"><button class="whereRefPic" onclick="speak('I am at the park.')"><img src="${ref.img}"><div>Park</div></button><div class="whereRefText"><button class="refLine" onclick="speak('Where are you?')">QUESTION: <span>Where are you?</span></button><button class="refLine" onclick="speak('I am at the')">ANSWER FRAME: <span>I am at the ________.</span></button><button class="refLine" onclick="speak('I am at the park.')">EXAMPLE: <span>Park → I am at the park.</span></button></div></div><div class="sentenceFrame" onclick="speak('Where are you? I am at the park.')"><small>Tap to hear the model again</small>Where are you? → <strong>I am at the ________.</strong></div><div class="subprompt"><b>Picture clue:</b> Look at this place, then choose the matching card.</div><div style="display:flex;justify-content:center;margin:10px 0 16px"><div class="choice" style="width:min(320px,70vw);pointer-events:none"><img src="${currentWhere.img}" alt="Picture clue" style="height:24vh"><div class="cap">?</div></div></div><div class="choiceGrid">${choices.map(p=>`<button class="choice" onclick="checkWhere('${p.id}',this)"><img src="${p.img}"><div class="cap">${p.label}</div></button>`).join('')}</div>`;speak('Where are you?')}
function checkWhere(id,el){if(id===currentWhere.id){el.classList.add('good');speak(`I am at the ${currentWhere.id}.`);setTimeout(newWhere,1500)}else{el.classList.add('bad');speak('Try again.');setTimeout(()=>el.classList.remove('bad'),650)}}
function newGuess(mode='picture',btn){guessMode=mode;setTab(btn,'[data-guesstab]');currentGuess=rand(ACTIONS);const choices=shuffle([currentGuess,...shuffle(ACTIONS.filter(a=>a!==currentGuess)).slice(0,3)]);const question=`What is ${currentGuess.pro.toLowerCase()} doing?`;const lead=mode==='clue'?`<div class="sentenceFrame" onclick="speak('${currentGuess.clue}')"><small>Tap to hear clue</small>${currentGuess.clue}</div>`:`<img class="reportPic" src="${currentGuess.img}">`;q('#guessBody').innerHTML=`<div class="panel"><div class="prompt">${mode==='clue'?'Listen and Guess':'Look and Guess'}</div>${lead}<div class="sentenceFrame" onclick="speak('${question}')">${question}<br><strong>${currentGuess.pro} is ________.</strong></div><div class="miniActions">${choices.map(a=>`<button class="pill" onclick="checkGuess('${a.word}',this)">${a.word}</button>`).join('')}</div></div>`;if(mode==='clue')speak(currentGuess.clue)}
function checkGuess(word,el){if(word===currentGuess.word){el.classList.add('good');speak(`${currentGuess.pro} is ${currentGuess.word}.`);setTimeout(()=>newGuess(guessMode),1400)}else{el.classList.add('bad');speak('Try again.');setTimeout(()=>el.classList.remove('bad'),650)}}
function newReporter(btn){setTab(btn,'[data-guesstab]');currentGuess=rand(ACTIONS);const qt=`What is ${currentGuess.pro.toLowerCase()} doing?`;q('#guessBody').innerHTML=`<div class="panel"><div class="prompt">🎤 Community Reporter</div><img class="reportPic" src="${currentGuess.img}"><div class="sentenceFrame" onclick="speak('${qt}')">${qt}</div><div class="miniActions"><button class="bigSpeak" onclick="speak('${qt}')">🔊 Ask</button><button class="bigSpeak green" onclick="speak('${currentGuess.pro} is ${currentGuess.word}.')">✓ Hear answer</button><button class="bigSpeak" onclick="newReporter()">➡ Next</button></div><div class="feedback">Student identifies the action and answers with a complete he/she sentence.</div></div>`;speak(qt)}
function newCombo(btn){setTab(btn,'[data-combotab]');const a=rand(ACTIONS),p=rand(PLACES);currentCombo={a,p};const s=`${a.pro} is ${a.word} at the ${p.id}.`;q('#comboBody').innerHTML=`<div class="panel"><div class="prompt">Action + Place</div><div class="subprompt">Tap each card, then tap the sentence to hear the complete model.</div><div class="combo"><button class="comboCard" onclick="speak('${a.word}')"><img src="${a.img}"><div>${a.word}</div></button><div class="plus">+</div><button class="comboCard" onclick="speak('${p.id}')"><img src="${p.img}"><div>${p.label}</div></button></div><div class="sentenceFrame" onclick="speak('${s}')">${a.pro} is <strong>${a.word}</strong> at the <strong>${p.id}</strong>.</div><button class="bigSpeak green" onclick="newCombo()">🔀 New combination</button></div>`}
function newComboChallenge(btn){setTab(btn,'[data-combotab]');const a=rand(ACTIONS),p=rand(PLACES);currentCombo={a,p,pickA:false,pickP:false};const oa=shuffle([a,...shuffle(ACTIONS.filter(x=>x!==a)).slice(0,2)]),op=shuffle([p,...shuffle(PLACES.filter(x=>x!==p)).slice(0,2)]);q('#comboBody').innerHTML=`<div class="panel"><div class="prompt">Practice Challenge</div><div class="combo"><div class="comboCard"><img src="${a.img}"><div>Action</div></div><div class="plus">+</div><div class="comboCard"><img src="${p.img}"><div>Place</div></div></div><div class="sentenceFrame">${a.pro} is ________ at the ________.</div><div class="subprompt">Choose the action and place.</div><div class="miniActions">${oa.map(x=>`<button class="pill" onclick="chooseCombo('a','${x.word}',this)">${x.word}</button>`).join('')}</div><div class="miniActions">${op.map(x=>`<button class="pill" onclick="chooseCombo('p','${x.id}',this)">${x.label}</button>`).join('')}</div><div id="comboFeedback" class="feedback"></div><button class="bigSpeak green" onclick="newComboChallenge()">➡ Next challenge</button></div>`}
function chooseCombo(type,val,el){const ok=type==='a'?val===currentCombo.a.word:val===currentCombo.p.id;if(ok){el.classList.add('good');type==='a'?currentCombo.pickA=true:currentCombo.pickP=true;speak(type==='a'?currentCombo.a.word:currentCombo.p.id)}else{el.classList.add('bad');speak('Try again.');setTimeout(()=>el.classList.remove('bad'),600)}if(currentCombo.pickA&&currentCombo.pickP){const s=`${currentCombo.a.pro} is ${currentCombo.a.word} at the ${currentCombo.p.id}.`;q('#comboFeedback').textContent='✓ '+s;speak(s)}}
function openSlides(pages){slideReturn=qa('.screen').find(s=>s.classList.contains('active'))?.id||'home';slidePages=pages;slidePos=0;openSection('slides');renderSlide()}function closeSlides(){openSection(slideReturn||'home')}function renderSlide(){const n=slidePages[slidePos],phrases=SLIDE_AUDIO[n]||[];const audioButtons=phrases.map((t,i)=>{const answerOnly=(n===5&&i>0&&i!==2)||(n===6);return answerOnly?`<button class="slideAudio iconOnly" title="Play answer" aria-label="Play answer" onclick='speak(${JSON.stringify(t)})'>🔊</button>`:`<button class="slideAudio" onclick='speak(${JSON.stringify(t)})'>🔊 ${t}</button>`}).join('');q('#slidesBody').innerHTML=`<div class="slideWrap"><div class="slideMain"><img src="assets/slides/${String(n).padStart(2,'0')}.webp" alt="Lesson slide ${n}"></div><aside class="slideSide"><h3>Slide ${n}</h3><div class="subprompt" style="text-align:left">Tap 🔊 to hear.</div><div class="slideAudioGroup">${audioButtons}</div><div class="slideNav"><button onclick="slidePrev()">◀ Previous</button><button onclick="slideNext()">Next ▶</button></div></aside></div>`}function slidePrev(){slidePos=(slidePos-1+slidePages.length)%slidePages.length;renderSlide()}function slideNext(){slidePos=(slidePos+1)%slidePages.length;renderSlide()}
renderPlaces();
